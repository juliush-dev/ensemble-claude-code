# Python bytecode from running merge-settings.py or its fixture. A .pyc embeds
# the absolute path it was compiled from, so committing one under this subtree
# would publish a path from whatever machine happened to build it.
__pycache__/
*.pyc

# Host companion of the Ensemble's settings.json, carries machine paths
# (permissions.additionalDirectories); deploy-to-host.{ps1,sh} replaces the
# paths it declares in the host's settings.json. Never tracked; the tracked
# counterpart is settings.local.example.json, and settings.local.example.md
# describes it.
/settings.local.json
