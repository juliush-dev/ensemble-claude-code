{
  "model": "opus",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "remoteControlAtStartup": false,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Edit(/agent-memory/**)",
      "mcp__playwright__browser_run_code*"
    ],
    "additionalDirectories": [
      "C:\\Users\\example\\Projects",
      "C:\\Users\\example\\Shared-External-Brain"
    ],
    "allow": [
      "Bash(ls)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "guard-push-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "guard-archivist-paths.sh main-session"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "host-own-hook.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "agentPushNotifEnabled": true
}
