{
  "permissions": {
    "ask": [
      "mcp__claude_ai_*",
      "Bash(git push)",
      "Host(ask)"
    ],
    "deny": [
      "HostAdded(**)",
      "edit(/agent-memory/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "C:\\Users\\example\\Projects",
      "C:\\Users\\example\\Shared-External-Brain"
    ],
    "allow": [
      "Bash(ls)"
    ]
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "guard-push-gate.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "guard-archivist-paths.sh main-session"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "host-session-start.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo compaction-marker-v1"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "host-own-hook.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "factory-notify.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "host-notify.sh"
          }
        ]
      }
    ]
  },
  "_provenance_retired": "declared by an earlier release, retired since",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "agentPushNotifEnabled": true
}
