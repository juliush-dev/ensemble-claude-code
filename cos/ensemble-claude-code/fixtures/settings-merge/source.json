{
  "model": "opus",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "remoteControlAtStartup": false,
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Edit(/agent-memory/**)",
      "mcp__playwright__browser_run_code*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "guard-push-gate.sh"
          }
        ]
      },
      {
        "_provenance_note": "factory narration; changes no behavior",
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "guard-archivist-paths.sh main-session"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo compaction-marker-v2"
          }
        ]
      }
    ]
  }
}
